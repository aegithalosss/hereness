{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": {
      "script": "node tools/prepare-dist.cjs && node tools/mac-resources.cjs",
      "wait": true
    },
    "beforeBuildCommand": "node tools/prepare-dist.cjs --release && node tools/mac-resources.cjs --release"
  },
  "bundle": {
    "resources": {
      "target/mac-resources/skins/": "skins/",
      "target/mac-resources/status/": "status/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_ASSETS.md": "THIRD_PARTY_ASSETS.md"
    }
  }
}
