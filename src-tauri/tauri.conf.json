{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hereness",
  "version": "0.1.2",
  "identifier": "com.aegithalos.hereness",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": {
      "script": "node tools/prepare-dist.cjs",
      "wait": true
    },
    "beforeBuildCommand": "node tools/prepare-dist.cjs --release"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "在呢 | Hereness",
        "width": 220,
        "height": 236,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
